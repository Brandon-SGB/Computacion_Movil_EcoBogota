<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvNombrePunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_nombre_punto" />

        <TextView
            android:id="@+id/tvDireccionPunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_direccion_punto" />

        <TextView
            android:id="@+id/tvHorarioPunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_horario_punto" />

        <TextView
            android:id="@+id/tvTiposResiduoPunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_tipos_residuo_punto" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
