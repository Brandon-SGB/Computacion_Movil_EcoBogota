<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivFotoReporte"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:contentDescription="@string/descripcion_foto_reporte"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDescripcionReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_descripcion_reporte" />

        <TextView
            android:id="@+id/tvFechaReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_fecha_reporte" />

        <TextView
            android:id="@+id/tvTipoProblemaReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_tipo_problema_reporte" />

        <TextView
            android:id="@+id/tvEstadoReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_estado_reporte" />

        <TextView
            android:id="@+id/tvUbicacionReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_ubicacion_reporte"
            android:visibility="gone" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
